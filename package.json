{
  "name": "wigl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "postinstall": "bun run widget:types",
    "build": "tsc && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write ./src",
    "format:check": "biome check ./src",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "setup": "sh scripts/install-deps.sh",
    "verify": "sh scripts/verify.sh",
    "qa": "sh scripts/qa.sh",
    "qa:app": "sh scripts/qa.sh --windowed",
    "kill": "pkill -x wigl || true; pkill -f 'opencode serve' || true",
    "wigl": "bun scripts/wigl.ts",
    "tw-colors": "bun scripts/tw-colors.ts",
    "check:eager": "bun scripts/check-eager.ts",
    "typecheck:widgets": "tsc -p wigl-widgets --noEmit",
    "widget:build": "NODE_ENV=production bun scripts/widget.ts build",
    "widget:install": "NODE_ENV=production bun scripts/widget.ts install",
    "widget:list": "bun scripts/widget.ts list",
    "widget:rm": "bun scripts/widget.ts rm",
    "widget:devkit": "bun scripts/widget.ts devkit",
    "widget:types": "tsc -p tsconfig.types.json",
    "widget:check": "NODE_ENV=production bun scripts/widget.ts check"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "~2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "react-scan": "^0.5.7",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
