{
  // Emits the host API as `.d.ts` into `wigl-widgets/types/`, which is what
  // widgets typecheck against — never the app's `src/` directly. Two reasons
  // it's worth the extra step: a widget author outside this repo needs
  // *something* shippable to type against, and pointing widget `paths` at
  // live app source would make "it compiles" depend on files that aren't
  // part of the plugin contract.
  //
  // Type-level access here is deliberately broader than runtime access: the
  // real gate is the build (`scripts/widget.ts`), which only externalizes
  // the specifiers in `host-modules.ts`. Anything else a widget imports from
  // `@/` fails to bundle, loudly, before it can ever reach a user.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./wigl-widgets/types",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"],
  "references": []
}
