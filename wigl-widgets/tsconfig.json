{
  // Plugins typecheck against this, never the app's root tsconfig — that's
  // the point of this folder. `paths` resolves `@/...` to generated `.d.ts`
  // under `types/` (`bun run plugin:types`), not to `../src`, so a plugin
  // can never compile against app internals that happen to share a repo
  // with it.
  //
  // Types are intentionally broader than the runtime API: `@/*` resolves at
  // the type level, but only the specifiers in
  // `src/wigl/plugins/host-modules.ts` are externalized by the build, so a
  // deep import like `@/wigl/Desktop` fails at `bun run plugin:build` with a
  // resolution error rather than silently bundling a second copy of a host
  // component (and, for anything React-shaped, a second React).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./types/*"]
    }
  },
  "include": ["*/**/*.ts", "*/**/*.tsx"],
  "exclude": ["*/.wigl", "types"]
}
